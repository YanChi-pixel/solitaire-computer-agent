# ============================================================================
# Copy to .env and fill in your own values. .env itself is never committed.
# ============================================================================

# LLM backend for the strategist: "ollama" (local, free) or "deepseek" (cloud API).
LLM_BACKEND=ollama

# Local Ollama model (used when LLM_BACKEND=ollama).
# 14b gives the best reasoning but takes 5-20 s per move; 7b is noticeably faster.
OLLAMA_MODEL=qwen2.5:14b

# Cloud API key (used only when LLM_BACKEND=deepseek).
DEEPSEEK_API_KEY=

# Undo mechanism, used only when a move fails verification (screen is rolled
# back before the retry): "ctrl_z" sends Ctrl+Z, "button:x,y" clicks the game's
# Undo button at the given screen coordinates.
UNDO_METHOD=ctrl_z
UNDO_BUTTON_XY=40,40
